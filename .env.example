# Copy to .env and replace every CHANGE_ME value. Never commit .env.
DJANGO_SECRET_KEY=CHANGE_ME_use_a_long_random_string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=careerlens
MYSQL_USER=careerlens
MYSQL_PASSWORD=CHANGE_ME_application_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_ENABLED=true
# Optional OpenAI-compatible chat-completions provider. Set all three together.
# LLM_BASE_URL should end at /v1, not /chat/completions. HTTPS is required.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Enable only behind an HTTPS reverse proxy in a production deployment.
DJANGO_SECURE_SSL_REDIRECT=false
# Optional hosted database. Leave empty to use the MySQL settings above.
DATABASE_URL=
# Use database storage for a small serverless demo; local originals use the filesystem.
PRIVATE_FILE_STORAGE=filesystem
MAX_UPLOAD_MIB=5
DJANGO_ADMIN_PATH=admin/
